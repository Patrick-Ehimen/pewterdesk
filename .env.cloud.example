# PewterDesk Cloud: the Supabase project the Plan page's journal is kept in
# (supabase/README.md). Copy to .env.cloud (gitignored); every `make`
# target passes it to cargo and Tauri. Fixed at build time.
PEWTERDESK_CLOUD_URL=https://your-project-ref.supabase.co
PEWTERDESK_CLOUD_KEY=your-anon-public-key
